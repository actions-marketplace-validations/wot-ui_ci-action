{
  "name": "@wot-ui/ci-action",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "GitHub Action for Wot CI mini-program uploads and previews",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wot-ui/ci-action.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
